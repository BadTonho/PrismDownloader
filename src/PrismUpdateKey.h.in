#ifndef PRISMUPDATEKEY_H
#define PRISMUPDATEKEY_H

// This is the raw 32-byte Ed25519 public key encoded as Base64. Release CI
// derives it from PRISM_UPDATE_ED25519_PRIVATE_KEY before compiling packages.
#define PRISM_UPDATE_PUBLIC_KEY_BASE64 "@PRISM_UPDATE_PUBLIC_KEY_BASE64@"

#endif // PRISMUPDATEKEY_H
